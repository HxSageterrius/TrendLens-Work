# Large Datasets & Media (DeepFashion2, Stanford Cars, etc.)
# Never commit raw gigabytes of images to Git
data/raw/*
data/processed/*
data/embeddings/*
data/forecasts/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/embeddings/.gitkeep
!data/forecasts/.gitkeep
!data/forecasts/*.json
!data/embeddings/*.csv
!data/samples/
!data/fashion_trends/
*.mat

# Scratch & temporary review directories
scratch/

# External cloned repositories & reference archives
reference_repos/
fashion_trend_analyzer-main/

# Model Checkpoints and Weights
*.pt
*.pth
*.bin
*.onnx
*.h5
!models/.gitkeep

# IDE and Operating System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
